<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.AccueilDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %>
<% List<AccueilDao.RendezVousLigne> rdvs=(List<AccueilDao.RendezVousLigne>)request.getAttribute("rendezVous"); List<AccueilDao.MedecinOption> med=(List<AccueilDao.MedecinOption>)request.getAttribute("medecins"); List<AccueilDao.PatientOption> pats=(List<AccueilDao.PatientOption>)request.getAttribute("patientsVerifies"); String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF); boolean hist="historique".equals(request.getAttribute("route")); boolean agenda="agenda".equals(request.getAttribute("route")); String du=String.valueOf(request.getAttribute("dateDu")),au=String.valueOf(request.getAttribute("dateAu")); %>
<section class="accueil-page"><div class="page-heading"><div><p class="eyebrow"><%=hist?"SUIVI":"ORGANISATION"%></p><h2><%=hist?"Historique des rendez-vous":agenda?"Calendrier des médecins":"Rendez-vous"%></h2><p><%=agenda?"Agenda construit à partir des rendez-vous enregistrés.":"Planifiez et gérez les rendez-vous des patients vérifiés."%></p></div></div>
<% if(request.getAttribute("messageSucces")!=null){ %><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><% } if(request.getAttribute("erreur")!=null){ %><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><% } %>
<div class="panel"><form class="toolbar" method="get" action="<%=request.getContextPath()%>/accueil/<%=hist?"historique":agenda?"agenda":"rendezvous"%>" data-ajax-form><label>Du <input type="date" name="du" value="<%=du%>"></label><label>Au <input type="date" name="au" value="<%=au%>"></label><label>Médecin <select name="medecin"><option value="">Tous les médecins</option><% if(med!=null)for(AccueilDao.MedecinOption m:med){ %><option value="<%=m.id()%>"><%=Echappement.html(m.nomComplet())%></option><% } %></select></label><% if(!hist){ %><label>Statut <select name="statut"><option value="">Tous</option><option>EN_ATTENTE</option><option>CONFIRME</option><option>TERMINE</option><option>ANNULE</option><option>NON_HONORE</option></select></label><% } %><button class="btn btn-primary">Filtrer</button></form></div>
<% if(!hist&&!agenda){ %><div class="panel"><div class="panel-head"><div><h3>Planifier un rendez-vous</h3><p>Les choix proviennent des patients vérifiés et des médecins actifs.</p></div></div><% if(pats==null||pats.isEmpty()||med==null||med.isEmpty()){ %><div class="empty-state">Pour planifier, la base doit contenir au moins un patient vérifié et un médecin actif.</div><% } else { %><form method="post" action="<%=request.getContextPath()%>/accueil/rendezvous/creer" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><label>Patient<select name="patientId" required><option value="">Choisir</option><% for(AccueilDao.PatientOption p:pats){ %><option value="<%=p.id()%>"><%=Echappement.html(p.numero()+" — "+p.nomComplet())%></option><% } %></select></label><label>Médecin<select name="medecinId" required><option value="">Choisir</option><% for(AccueilDao.MedecinOption m:med){ %><option value="<%=m.id()%>"><%=Echappement.html(m.nomComplet()+(m.service()==null?"":" — "+m.service()))%></option><% } %></select></label><label>Date<input type="date" name="date" required min="<%=java.time.LocalDate.now()%>"></label><label>Heure de début<input type="time" name="debut" required></label><label>Heure de fin<input type="time" name="fin" required></label><label>Motif administratif<input name="motif" maxlength="500"></label><div class="form-actions"><button class="btn btn-primary">Planifier</button></div></form><% } %></div><% } %>
<% AccueilDao.RendezVousEdition ed=(AccueilDao.RendezVousEdition)request.getAttribute("rendezVousEdition"); if(ed!=null&&pats!=null&&med!=null){ %><div class="panel"><div class="panel-head"><div><h3>Modifier le rendez-vous #<%=ed.id()%></h3><p>La modification est réservée aux rendez-vous en attente ou confirmés.</p></div></div><form method="post" action="<%=request.getContextPath()%>/accueil/rendezvous/modifier" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=ed.id()%>"><label>Patient<select name="patientId" required><% for(AccueilDao.PatientOption p:pats){ %><option value="<%=p.id()%>" <%=p.id()==ed.patientId()?"selected":""%>><%=Echappement.html(p.numero()+" — "+p.nomComplet())%></option><% } %></select></label><label>Médecin<select name="medecinId" required><% for(AccueilDao.MedecinOption m:med){ %><option value="<%=m.id()%>" <%=m.id()==ed.medecinId()?"selected":""%>><%=Echappement.html(m.nomComplet())%></option><% } %></select></label><label>Date<input type="date" name="date" required min="<%=java.time.LocalDate.now()%>" value="<%=ed.date()%>"></label><label>Début<input type="time" name="debut" required value="<%=ed.debut()%>"></label><label>Fin<input type="time" name="fin" required value="<%=ed.fin()%>"></label><label>Motif administratif<input name="motif" maxlength="500"></label><div class="form-actions"><button class="btn btn-primary">Enregistrer les changements</button></div></form></div><% } %>
<% if(agenda){ %><div class="panel"><div class="calendar-grid"><% java.time.LocalDate start=(java.time.LocalDate)request.getAttribute("dateDu"); for(int day=0;day<7;day++){java.time.LocalDate d=start.plusDays(day); %><div class="calendar-day"><h4><%=d.getDayOfWeek().getDisplayName(java.time.format.TextStyle.SHORT,java.util.Locale.FRENCH)%> <%=d.getDayOfMonth()%></h4><% if(rdvs!=null)for(AccueilDao.RendezVousLigne r:rdvs)if(r.date().equals(d)){ %><article class="calendar-event"><b><%=r.debut()%></b> <%=Echappement.html(r.nomPatient())%><small><%=Echappement.html(r.nomMedecin())%> · <%=Echappement.html(r.statut())%></small></article><% } %></div><% } %></div></div><% } %>
<div class="panel"><div class="panel-head"><div><h3><%=hist?"Rendez-vous passés et à venir":"Rendez-vous enregistrés"%></h3><p>Résultats issus de PostgreSQL. Le motif médical détaillé n’est pas affiché.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date / heure</th><th>Patient</th><th>Médecin</th><th>Service</th><th>Statut</th><% if(!hist&&!agenda){ %><th>Actions</th><% } %></tr></thead><tbody><% if(rdvs!=null)for(AccueilDao.RendezVousLigne r:rdvs){ %><tr><td><%=r.date()%><small><%=r.debut()%> – <%=r.fin()%></small></td><td><%=Echappement.html(r.numeroPatient()+" · "+r.nomPatient())%></td><td><%=Echappement.html(r.nomMedecin())%></td><td><%=Echappement.html(r.service())%></td><td><span class="chip"><%=Echappement.html(r.statut())%></span></td><% if(!hist&&!agenda){ %><td class="actions"><% if("EN_ATTENTE".equals(r.statut())||"CONFIRME".equals(r.statut())){ %><a class="btn btn-small" href="<%=request.getContextPath()%>/accueil/rendezvous?modifier=<%=r.id()%>" data-fragment-link>Modifier</a><% } if("EN_ATTENTE".equals(r.statut())){ %><form method="post" action="<%=request.getContextPath()%>/accueil/rendezvous/confirmer" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=r.id()%>"><button class="btn btn-small">Confirmer</button></form><% } if("EN_ATTENTE".equals(r.statut())||"CONFIRME".equals(r.statut())){ %><form method="post" action="<%=request.getContextPath()%>/accueil/rendezvous/annuler" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=r.id()%>"><input type="hidden" name="motif" value="Annulation demandée à l’accueil"><button class="btn btn-small btn-danger" data-confirm-submit="Annuler ce rendez-vous ?">Annuler</button></form><% } %></td><% } %></tr><% } %></tbody></table><% if(rdvs==null||rdvs.isEmpty()){ %><p class="empty-state">Aucun rendez-vous sur cette période.</p><% } %></div></div></section>
