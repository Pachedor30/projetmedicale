<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.AccueilDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %>
<% List<AccueilDao.PatientResume> ps=(List<AccueilDao.PatientResume>)request.getAttribute("patients"); AccueilDao.PatientEdition ed=(AccueilDao.PatientEdition)request.getAttribute("patientEdition"); AccueilDao.PatientCree pc=(AccueilDao.PatientCree)request.getAttribute("patientCree"); String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF); String q=Echappement.html(request.getParameter("q")); %>
<section class="accueil-page"><div class="page-heading"><div><p class="eyebrow">DOSSIER ADMINISTRATIF</p><h2>Gestion des patients</h2><p>Recherche par numéro de patient, nom ou téléphone.</p></div></div>
<% if(request.getAttribute("messageSucces")!=null){ %><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><% } if(request.getAttribute("erreur")!=null){ %><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><% } if(pc!=null){ %><div class="alert-success"><strong>Compte patient créé</strong><br>Numéro patient : <b><%=Echappement.html(pc.numeroDossier())%></b></div><% } %>
<div class="panel"><div class="panel-head"><div><h3>Rechercher un patient</h3><p>Les résultats affichent uniquement les coordonnées administratives.</p></div></div><form class="toolbar" method="get" action="<%=request.getContextPath()%>/accueil/patients" data-ajax-form><input type="search" name="q" value="<%=q%>" placeholder="Numéro patient, nom ou téléphone"><button class="btn btn-primary">Rechercher</button></form>
<div class="table-wrap"><table class="table"><thead><tr><th>N° patient</th><th>Patient</th><th>Téléphone</th><th>Rattachement</th><th>Dossier</th><th>Actions</th></tr></thead><tbody><% if(ps!=null) for(AccueilDao.PatientResume p:ps){ %><tr><td><%=Echappement.html(p.numeroDossier())%></td><td><strong><%=Echappement.html(p.prenoms()+" "+p.nom())%></strong><small><%=Echappement.html(p.email())%></small></td><td><%=Echappement.html(p.telephone())%></td><td><span class="chip"><%=Echappement.html(p.statutRattachement())%></span></td><td><%=p.dossierOuvert()?"Ouvert":"Non ouvert"%></td><td class="actions"><a class="btn btn-small" href="<%=request.getContextPath()%>/accueil/patients?modifier=<%=p.id()%>" data-fragment-link>Modifier</a><form method="post" action="<%=request.getContextPath()%>/accueil/patients/dossier" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><button class="btn btn-small" <%=p.dossierOuvert()?"disabled":""%>>Ouvrir dossier</button></form></td></tr><% } %></tbody></table><% if(ps==null||ps.isEmpty()){ %><p class="empty-state">Aucun patient correspondant dans la base.</p><% } %></div></div>
<% if(ed!=null){ %><div class="panel"><div class="panel-head"><div><h3>Modifier le dossier administratif</h3><p><%=Echappement.html(ed.numeroDossier())%> — aucun renseignement clinique n’est affiché ici.</p></div></div><form method="post" action="<%=request.getContextPath()%>/accueil/patients/modifier" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=ed.id()%>"><label>Prénom(s)<input name="prenoms" required maxlength="100" value="<%=Echappement.html(ed.prenoms())%>"></label><label>Nom<input name="nom" required maxlength="100" value="<%=Echappement.html(ed.nom())%>"></label><label>Email<input type="email" name="email" required maxlength="120" value="<%=Echappement.html(ed.email())%>"></label><label>Téléphone<input name="telephone" maxlength="30" value="<%=Echappement.html(ed.telephone())%>"></label><label>Sexe<select name="sexe" required><option value="M" <%= "M".equals(ed.sexe())?"selected":""%>>Masculin</option><option value="F" <%= "F".equals(ed.sexe())?"selected":""%>>Féminin</option></select></label><label>Date de naissance<input type="date" name="date_naissance" value="<%=ed.dateNaissance()==null?"":ed.dateNaissance()%>" max="<%=java.time.LocalDate.now()%>"></label><label>Adresse<input name="adresse" maxlength="300" value="<%=Echappement.html(ed.adresse())%>"></label><label>Profession<input name="profession" maxlength="120" value="<%=Echappement.html(ed.profession())%>"></label><label>Contact d’urgence<input name="contact_urgence" maxlength="120" value="<%=Echappement.html(ed.contactUrgence())%>"></label><label>Téléphone d’urgence<input name="telephone_urgence" maxlength="30" value="<%=Echappement.html(ed.telephoneUrgence())%>"></label><div class="form-actions"><button class="btn btn-primary">Enregistrer</button></div></form></div><% } %>
<div class="panel"><div class="panel-head"><div><h3>Enregistrer un patient</h3><p>Choisissez avec le patient son mot de passe initial. Il devra le changer à sa première connexion.</p></div></div><form method="post" action="<%=request.getContextPath()%>/accueil/patients/creer" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><label>Prénom(s)<input name="prenoms" required maxlength="100"></label><label>Nom<input name="nom" required maxlength="100"></label><label>Email<input type="email" name="email" required maxlength="120"></label><label>Téléphone<input name="telephone" maxlength="30"></label><label>Mot de passe initial<input type="password" name="motDePasse" required minlength="8" maxlength="128" autocomplete="new-password"></label><label>Confirmer le mot de passe<input type="password" name="confirmationMotDePasse" required minlength="8" maxlength="128" autocomplete="new-password"></label><label>Sexe<select name="sexe" required><option value="">Choisir</option><option value="M">Masculin</option><option value="F">Féminin</option></select></label><label>Date de naissance<input type="date" name="date_naissance" max="<%=java.time.LocalDate.now()%>"></label><label>Adresse<input name="adresse" maxlength="300"></label><label>Profession<input name="profession" maxlength="120"></label><label>Contact d’urgence<input name="contact_urgence" maxlength="120"></label><label>Téléphone d’urgence<input name="telephone_urgence" maxlength="30"></label><label class="check-field"><input type="checkbox" name="identite_verifiee" required> Je confirme avoir vérifié l’identité du patient.</label><div class="form-actions"><button class="btn btn-primary">Créer le compte patient</button></div></form></div></section>
