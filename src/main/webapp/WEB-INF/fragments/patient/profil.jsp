<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %><%PatientPortailDao.Profil p=(PatientPortailDao.Profil)request.getAttribute("profil");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">MON COMPTE</p><h2>Mes informations personnelles</h2><p>Vous pouvez modifier vos coordonnées. Votre numéro patient et votre rôle ne sont pas modifiables.</p></div></div><%if(request.getAttribute("messageSucces")!=null){%><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><%}if(request.getAttribute("erreur")!=null){%><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><%}%><div class="panel"><div class="patient-id-card"><span>Numéro patient</span><strong><%=Echappement.html(p.numero())%></strong></div><form method="post" action="<%=request.getContextPath()%>/patient/profil/modifier" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><label>Prénom(s)<input name="prenoms" required maxlength="80" value="<%=Echappement.html(p.prenoms())%>"></label><label>Nom<input name="nom" required maxlength="60" value="<%=Echappement.html(p.nom())%>"></label><label>Email<input type="email" name="email" required maxlength="120" value="<%=Echappement.html(p.email())%>"></label><label>Téléphone<input name="telephone" maxlength="20" value="<%=Echappement.html(p.telephone())%>"></label><label class="full">Adresse<input name="adresse" maxlength="300" value="<%=Echappement.html(p.adresse())%>"></label><label>Contact d’urgence<input name="contactUrgence" maxlength="120" value="<%=Echappement.html(p.contactUrgence())%>"></label><label>Téléphone d’urgence<input name="telephoneUrgence" maxlength="20" value="<%=Echappement.html(p.telephoneUrgence())%>"></label><label>Date de naissance<input readonly value="<%=p.naissance()==null?"Non renseignée":p.naissance()%>"></label><label>Sexe<input readonly value="<%=Echappement.html(p.sexe())%>"></label><label class="full">Identifiant de compte<input readonly value="<%=p.id()%>"></label><div class="full"><button class="btn btn-primary">Enregistrer mes coordonnées</button></div></form></div></section>
