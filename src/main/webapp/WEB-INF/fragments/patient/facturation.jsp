<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement" %><%List<PatientPortailDao.Facture> fs=(List<PatientPortailDao.Facture>)request.getAttribute("factures");List<PatientPortailDao.Paiement> ps=(List<PatientPortailDao.Paiement>)request.getAttribute("paiements");String ctx=request.getContextPath();%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">MES FINANCES</p><h2>Factures et paiements</h2><p>Consultez vos factures, soldes et reçus de paiement.</p></div></div><div class="panel"><h3>Mes factures</h3><div class="table-wrap"><table class="table"><thead><tr><th>Numéro</th><th>Date</th><th>Échéance</th><th>Total</th><th>Payé</th><th>Reste dû</th><th>Statut</th><th>PDF</th></tr></thead><tbody><%if(fs!=null)for(PatientPortailDao.Facture f:fs){%><tr><td><%=Echappement.html(f.numero())%></td><td><%=f.date()%></td><td><%=f.echeance()==null?"—":f.echeance()%></td><td><%=f.total().toPlainString()%></td><td><%=f.paye().toPlainString()%></td><td><strong><%=f.restant().toPlainString()%></strong></td><td><%=Echappement.html(f.statut())%></td><td><a target="_blank" href="<%=ctx%>/patient/facture-pdf?id=<%=f.id()%>">Télécharger</a></td></tr><%}%></tbody></table><%if(fs==null||fs.isEmpty()){%><p class="empty-state">Aucune facture à afficher.</p><%}%></div></div><div class="panel"><h3>Historique des paiements</h3><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Facture</th><th>Montant</th><th>Mode</th><th>Référence</th><th>Solde après paiement</th><th>Reçu PDF</th></tr></thead><tbody><%if(ps!=null)for(PatientPortailDao.Paiement p:ps){%><tr><td><%=p.date()%></td><td><%=Echappement.html(p.numeroFacture())%></td><td><%=p.montant().toPlainString()%></td><td><%=Echappement.html(p.mode())%></td><td><%=Echappement.html(p.reference())%></td><td><%=p.solde().toPlainString()%></td><td><a target="_blank" href="<%=ctx%>/patient/recu-pdf?id=<%=p.id()%>">REC-<%=p.id()%></a></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucun paiement enregistré.</p><%}%></div></div></section>
