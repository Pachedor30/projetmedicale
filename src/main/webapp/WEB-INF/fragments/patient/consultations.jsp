<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement" %><%List<PatientPortailDao.Consultation> cs=(List<PatientPortailDao.Consultation>)request.getAttribute("consultations");List<PatientPortailDao.Prescription> ps=(List<PatientPortailDao.Prescription>)request.getAttribute("prescriptions");%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">SUIVI MÉDICAL</p><h2>Mes consultations</h2><p>Consultations finalisées et prescriptions qui vous sont destinées.</p></div></div><div class="panel"><h3>Historique chronologique</h3><div class="timeline"><%if(cs!=null)for(PatientPortailDao.Consultation c:cs){%><article class="timeline-item"><div class="timeline-date"><%=c.date()%> · <%=Echappement.html(c.medecin())%></div><h4><%=Echappement.html(c.motif())%></h4><p><b>Observations :</b> <%=Echappement.html(c.observations())%></p><p><b>Diagnostic :</b> <%=Echappement.html(c.diagnostic())%></p><p><b>Conduite à tenir :</b> <%=Echappement.html(c.conduite())%></p></article><%}%><%if(cs==null||cs.isEmpty()){%><p class="empty-state">Aucune consultation finalisée à afficher.</p><%}%></div></div><div class="panel"><h3>Mes prescriptions</h3><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Médecin</th><th>Médicament</th><th>Dosage</th><th>Posologie</th><th>Durée</th><th>Statut</th></tr></thead><tbody><%if(ps!=null)for(PatientPortailDao.Prescription p:ps){%><tr><td><%=p.date()%></td><td><%=Echappement.html(p.medecin())%></td><td><%=Echappement.html(p.medicament())%></td><td><%=Echappement.html(p.dosage())%></td><td><%=Echappement.html(p.posologie())%></td><td><%=Echappement.html(p.duree())%></td><td><%=Echappement.html(p.statut())%></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucune prescription enregistrée.</p><%}%></div></div></section>
