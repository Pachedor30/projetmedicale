<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %><%List<PatientPortailDao.Notification> ns=(List<PatientPortailDao.Notification>)request.getAttribute("notifications");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">INFORMATIONS</p><h2>Mes notifications</h2><p>Rappels et messages associés à votre compte.</p></div></div><div class="patient-notifications"><%if(ns!=null)for(PatientPortailDao.Notification n:ns){%><article class="panel patient-notification <%=n.lue()?"read":"unread"%>"><div><span class="chip"><%=Echappement.html(n.type())%></span><small><%=n.date()%></small><h3><%=Echappement.html(n.titre())%></h3><p><%=Echappement.html(n.message())%></p><%if(n.lien()!=null&&n.lien().startsWith("/")){%><a href="<%=request.getContextPath()+Echappement.html(n.lien())%>">Ouvrir</a><%}%></div><%if(!n.lue()){%><form method="post" action="<%=request.getContextPath()%>/patient/notifications/lire" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=n.id()%>"><button class="btn btn-small">Marquer comme lue</button></form><%}%></article><%}%><%if(ns==null||ns.isEmpty()){%><div class="panel empty-state">Aucune notification reçue.</div><%}%></div></section>
