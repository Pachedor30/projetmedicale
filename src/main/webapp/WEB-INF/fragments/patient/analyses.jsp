<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement" %><%List<PatientPortailDao.Analyse> as=(List<PatientPortailDao.Analyse>)request.getAttribute("analyses");%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">LABORATOIRE</p><h2>Mes résultats d’analyses</h2><p>Seuls les résultats validés sont disponibles dans cette liste.</p></div></div><div class="panel"><div class="table-wrap"><table class="table"><thead><tr><th>Analyse</th><th>Date de validation</th><th>Résultat</th><th>Unité</th><th>Valeurs de référence</th><th>Interprétation</th></tr></thead><tbody><%if(as!=null)for(PatientPortailDao.Analyse a:as){%><tr><td><%=Echappement.html(a.type())%></td><td><%=a.date()%></td><td><strong><%=Echappement.html(a.valeur())%></strong></td><td><%=Echappement.html(a.unite())%></td><td><%=Echappement.html(a.references())%></td><td><%=Echappement.html(a.observations())%></td></tr><%}%></tbody></table><%if(as==null||as.isEmpty()){%><p class="empty-state">Aucun résultat validé disponible.</p><%}%></div></div></section>
