<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement" %><%PatientPortailDao.Profil p=(PatientPortailDao.Profil)request.getAttribute("profil");PatientPortailDao.Dossier d=(PatientPortailDao.Dossier)request.getAttribute("dossier");List<PatientPortailDao.Antecedent> as=(List<PatientPortailDao.Antecedent>)request.getAttribute("antecedents");%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">CARNET MÉDICAL</p><h2>Mon dossier</h2><p>Numéro patient : <strong><%=Echappement.html(p.numero())%></strong></p></div></div><%if(d==null){%><div class="panel"><p class="empty-state">Votre dossier médical n’a pas encore été ouvert par l’établissement.</p></div><%}else{%><div class="patient-two-col"><div class="panel"><h3>Antécédents généraux</h3><p class="medical-text"><%=Echappement.html(d.antecedentsGeneraux())%></p></div><div class="panel"><h3>Allergies</h3><p class="medical-text"><%=Echappement.html(d.allergies())%></p></div><div class="panel"><h3>Traitements en cours</h3><p class="medical-text"><%=Echappement.html(d.traitements())%></p></div><div class="panel"><h3>Dossier ouvert</h3><p><%=d.ouverture()%></p><p class="access-note">Les notes administratives internes ne sont pas affichées dans le portail.</p></div></div><%}%><div class="panel"><h3>Antécédents médicaux enregistrés</h3><div class="timeline"><%if(as!=null)for(PatientPortailDao.Antecedent a:as){%><article class="timeline-item"><b><%=Echappement.html(a.type())%> · <%=Echappement.html(a.libelle())%></b><p><%=Echappement.html(a.description())%></p><small><%=a.debut()==null?"":a.debut()%></small></article><%}%><%if(as==null||as.isEmpty()){%><p class="empty-state">Aucun antécédent enregistré.</p><%}%></div></div></section>
