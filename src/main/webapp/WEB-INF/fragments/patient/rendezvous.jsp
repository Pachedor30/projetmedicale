<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.PatientPortailDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %><%List<PatientPortailDao.Rdv> rs=(List<PatientPortailDao.Rdv>)request.getAttribute("rendezVous");List<PatientPortailDao.Medecin> ms=(List<PatientPortailDao.Medecin>)request.getAttribute("medecins");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);%><section class="patient-page"><div class="page-heading"><div><p class="eyebrow">RENDEZ-VOUS</p><h2>Mes rendez-vous</h2><p>Envoyez une demande ; le rendez-vous reste en attente jusqu’à confirmation.</p></div></div><%if(request.getAttribute("messageSucces")!=null){%><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><%}if(request.getAttribute("erreur")!=null){%><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><%}%><div class="panel"><h3>Demander un rendez-vous</h3><%if(ms==null||ms.isEmpty()){%><p class="empty-state">Aucun médecin actif n’est proposé actuellement.</p><%}else{%><form method="post" action="<%=request.getContextPath()%>/patient/rendezvous/demander" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><label>Médecin<select name="medecinId" required><option value="">Choisir</option><%for(PatientPortailDao.Medecin m:ms){%><option value="<%=m.id()%>"><%=Echappement.html(m.nom()+(m.service()==null?"":" · "+m.service()))%></option><%}%></select></label><label>Date souhaitée<input type="date" name="date" required min="<%=java.time.LocalDate.now()%>"></label><label>Heure de début<input type="time" name="debut" required></label><label>Heure de fin<input type="time" name="fin" required></label><label class="full">Motif de la demande<input name="motif" required maxlength="500" placeholder="Motif bref"></label><div class="full"><button class="btn btn-primary">Envoyer la demande</button></div></form><p class="access-note">Le créneau proposé sera vérifié par l’établissement. Une demande ne vaut pas confirmation.</p><%}%></div><div class="panel"><h3>Historique des rendez-vous</h3><div class="table-wrap"><table class="table"><thead><tr><th>Date / heure</th><th>Médecin</th><th>Service</th><th>Motif</th><th>Statut</th><th>Action</th></tr></thead><tbody><%if(rs!=null)for(PatientPortailDao.Rdv r:rs){%><tr><td><%=r.date()%><small><%=r.debut()%>–<%=r.fin()%></small></td><td><%=Echappement.html(r.medecin())%></td><td><%=Echappement.html(r.service())%></td><td><%=Echappement.html(r.motif())%></td><td><span class="chip"><%=Echappement.html(r.statut())%></span></td><td><%if(("EN_ATTENTE".equals(r.statut())||"CONFIRME".equals(r.statut()))&&!r.date().isBefore(java.time.LocalDate.now())){%><form method="post" action="<%=request.getContextPath()%>/patient/rendezvous/annuler" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=r.id()%>"><button class="btn btn-small btn-danger" data-confirm-submit="Annuler ce rendez-vous ?">Annuler</button></form><%}else{%>—<%}%></td></tr><%}%></tbody></table><%if(rs==null||rs.isEmpty()){%><p class="empty-state">Aucun rendez-vous enregistré.</p><%}%></div></div></section>
