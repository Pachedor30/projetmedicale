<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao,com.mycompany.projetmedical.util.Echappement" %><%List<CaisseDao.Patient> ps=(List<CaisseDao.Patient>)request.getAttribute("patients");%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">DOSSIERS FINANCIERS</p><h2>Patients</h2><p>Consultation de leurs factures et soldes, sans accès aux informations cliniques.</p></div></div><div class="panel"><form class="toolbar" method="get" action="<%=request.getContextPath()%>/caisse/patients" data-ajax-form><input type="search" name="q" placeholder="Numéro patient, nom ou téléphone" value="<%=Echappement.html(request.getParameter("q"))%>"><button class="btn btn-primary">Rechercher</button></form><div class="table-wrap"><table class="table"><thead><tr><th>N° patient</th><th>Patient</th><th>Téléphone</th><th></th></tr></thead><tbody><%if(ps!=null)for(CaisseDao.Patient p:ps){%><tr><td><%=Echappement.html(p.numero())%></td><td><%=Echappement.html(p.nom())%></td><td><%=Echappement.html(p.telephone())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/caisse/patient?id=<%=p.id()%>" data-fragment-link>Factures</a></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucun patient trouvé.</p><%}%></div></div></section>
