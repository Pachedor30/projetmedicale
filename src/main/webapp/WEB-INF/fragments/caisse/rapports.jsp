<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao" %><%List<CaisseDao.Rapport> rows=(List<CaisseDao.Rapport>)request.getAttribute("rapport");String du=String.valueOf(request.getAttribute("dateDu")),au=String.valueOf(request.getAttribute("dateAu"));java.math.BigDecimal total=(java.math.BigDecimal)request.getAttribute("totalRapport");Long nombre=(Long)request.getAttribute("nombreRapport");%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">ANALYSE FINANCIÈRE</p><h2>Rapports d’encaissement</h2><p>Totaux calculés à partir des paiements enregistrés dans PostgreSQL.</p></div><button class="btn btn-small" type="button" onclick="window.print()">Imprimer le rapport</button></div><div class="panel"><form class="toolbar" method="get" action="<%=request.getContextPath()%>/caisse/rapports" data-ajax-form><label>Du<input type="date" name="du" value="<%=du%>" required></label><label>Au<input type="date" name="au" value="<%=au%>" required></label><button class="btn btn-primary">Générer</button></form><div class="invoice-totals"><div><span>Nombre de paiements</span><strong><%=nombre==null?0:nombre%></strong></div><div><span>Total encaissé</span><strong><%=total==null?"0.00":total.toPlainString()%></strong></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Jour</th><th>Nombre de paiements</th><th>Montant encaissé</th></tr></thead><tbody><%if(rows!=null)for(CaisseDao.Rapport r:rows){%><tr><td><%=r.jour()%></td><td><%=r.nombre()%></td><td><%=r.encaisse().toPlainString()%></td></tr><%}%></tbody></table><%if(rows==null||rows.isEmpty()){%><p class="empty-state">Aucun encaissement sur cette période.</p><%}%></div></div></section>
