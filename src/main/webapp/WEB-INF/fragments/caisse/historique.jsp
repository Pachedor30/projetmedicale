<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao,com.mycompany.projetmedical.util.Echappement" %><%List<CaisseDao.Paiement> ps=(List<CaisseDao.Paiement>)request.getAttribute("paiements");String du=String.valueOf(request.getAttribute("dateDu")),au=String.valueOf(request.getAttribute("dateAu"));%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">ENCAISSEMENTS</p><h2>Historique des paiements</h2><p>Reçus et soldes après chaque paiement confirmé.</p></div></div><div class="panel"><form class="toolbar" method="get" action="<%=request.getContextPath()%>/caisse/historique" data-ajax-form><label>Du<input type="date" name="du" value="<%=du%>"></label><label>Au<input type="date" name="au" value="<%=au%>"></label><input type="search" name="q" placeholder="Facture, patient, numéro" value="<%=Echappement.html(request.getParameter("q"))%>"><button class="btn btn-primary">Filtrer</button></form><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Facture</th><th>Patient</th><th>Montant</th><th>Mode</th><th>Référence</th><th>Solde après paiement</th><th>Reçu</th></tr></thead><tbody><%if(ps!=null)for(CaisseDao.Paiement p:ps){%><tr><td><%=p.date()%></td><td><a href="<%=request.getContextPath()%>/caisse/facture?id=<%=p.factureId()%>" data-fragment-link><%=Echappement.html(p.numeroFacture())%></a></td><td><%=Echappement.html(p.numeroPatient()+" · "+p.patient())%></td><td><%=p.montant().toPlainString()%></td><td><%=Echappement.html(p.mode())%></td><td><%=Echappement.html(p.reference())%></td><td><%=p.solde().toPlainString()%></td><td><a target="_blank" href="<%=request.getContextPath()%>/caisse/recu?id=<%=p.id()%>">PDF REC-<%=p.id()%></a></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucun paiement pour cette période.</p><%}%></div></div></section>
