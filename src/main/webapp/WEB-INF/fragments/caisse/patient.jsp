<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao,com.mycompany.projetmedical.util.Echappement" %><%CaisseDao.Patient p=(CaisseDao.Patient)request.getAttribute("patient");List<CaisseDao.Facture> fs=(List<CaisseDao.Facture>)request.getAttribute("factures");%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">PATIENT</p><h2><%=Echappement.html(p.nom())%></h2><p><%=Echappement.html(p.numero())%> · <%=Echappement.html(p.telephone())%></p></div><a class="btn btn-primary" href="<%=request.getContextPath()%>/caisse/nouvelle-facture" data-fragment-link>Créer une facture</a></div><div class="panel"><h3>Factures du patient</h3><div class="table-wrap"><table class="table"><thead><tr><th>Numéro</th><th>Date</th><th>Total</th><th>Payé</th><th>Reste dû</th><th>Statut</th><th></th></tr></thead><tbody><%if(fs!=null)for(CaisseDao.Facture f:fs){%><tr><td><%=Echappement.html(f.numero())%></td><td><%=f.date()%></td><td><%=f.total().toPlainString()%></td><td><%=f.paye().toPlainString()%></td><td><%=f.restant().toPlainString()%></td><td><%=Echappement.html(f.statut())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/caisse/facture?id=<%=f.id()%>" data-fragment-link>Ouvrir</a></td></tr><%}%></tbody></table><%if(fs==null||fs.isEmpty()){%><p class="empty-state">Aucune facture n’a encore été créée.</p><%}%></div></div></section>
