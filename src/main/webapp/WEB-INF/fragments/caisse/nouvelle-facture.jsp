<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %><%List<CaisseDao.Patient> pats=(List<CaisseDao.Patient>)request.getAttribute("patients");List<CaisseDao.Prestation> pres=(List<CaisseDao.Prestation>)request.getAttribute("prestations");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">NOUVELLE FACTURE</p><h2>Créer une facture</h2><p>Les tarifs et sous-totaux sont recalculés côté serveur à partir des prestations actives.</p></div></div><%if(request.getAttribute("erreur")!=null){%><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><%}%><div class="panel"><%if(pats==null||pats.isEmpty()){%><p class="empty-state">Aucun patient enregistré dans PostgreSQL.</p><%}else if(pres==null||pres.isEmpty()){%><p class="empty-state">Aucune prestation active n’est configurée. L’administrateur doit renseigner les tarifs.</p><%}else{%><form method="post" action="<%=request.getContextPath()%>/caisse/nouvelle-facture" data-ajax-form id="invoice-form"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><label class="form-label">Patient<select name="patientId" required><option value="">Choisir un patient</option><%for(CaisseDao.Patient p:pats){%><option value="<%=p.id()%>"><%=Echappement.html(p.numero()+" — "+p.nom())%></option><%}%></select></label><div class="panel-head"><div><h3>Lignes de facturation</h3><p>Ajoutez une ou plusieurs prestations au tarif enregistré.</p></div><button type="button" class="btn btn-small" id="add-line">Ajouter une ligne</button></div><div id="invoice-lines"><div class="invoice-line"><label>Prestation<select name="prestationId"><option value="">Sélectionner</option><%for(CaisseDao.Prestation p:pres){%><option value="<%=p.id()%>" data-price="<%=p.prix().toPlainString()%>"><%=Echappement.html(p.libelle())%> · <%=p.prix().toPlainString()%></option><%}%></select></label><label>Quantité<input type="number" name="quantite" min="0.01" step="0.01" value="1"></label><span class="line-price">Tarif chargé du catalogue</span><button type="button" class="btn btn-small remove-line">Retirer</button></div></div><p class="access-note">Les remises ne sont pas proposées tant qu’aucune règle et autorisation d’approbation n’existe dans les paramètres actuels.</p><label class="form-label">Échéance<input type="date" name="echeance" min="<%=java.time.LocalDate.now()%>"></label><label class="form-label">Notes<textarea name="notes" rows="3" maxlength="2000"></textarea></label><div class="form-actions"><button class="btn btn-primary">Créer la facture</button></div></form><%}%></div></section>
