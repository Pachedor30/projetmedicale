<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %><%CaisseDao.Facture f=(CaisseDao.Facture)request.getAttribute("facture");List<CaisseDao.Paiement> ps=(List<CaisseDao.Paiement>)request.getAttribute("paiements");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">FACTURE</p><h2><%=Echappement.html(f.numero())%></h2><p><%=Echappement.html(f.numeroPatient()+" · "+f.patient())%> · Émise le <%=f.date()%></p></div><a class="btn btn-small" href="<%=request.getContextPath()%>/caisse/patient?id=<%=f.patientId()%>" data-fragment-link>Factures du patient</a></div><%if(request.getAttribute("messageSucces")!=null){%><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><%}if(request.getAttribute("erreur")!=null){%><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><%}Long paiementId=(Long)request.getAttribute("paiementId");if(paiementId!=null){%><div class="receipt-callout">Paiement enregistré. <a target="_blank" href="<%=request.getContextPath()%>/caisse/recu?id=<%=paiementId%>">Ouvrir le reçu PDF REC-<%=paiementId%></a></div><%}%><div class="panel"><div class="panel-head"><div><h3>Lignes de facture</h3><p>Échéance : <%=f.echeance()==null?"Non définie":f.echeance()%></p></div><span class="chip"><%=Echappement.html(f.statut())%></span></div><div class="table-wrap"><table class="table"><thead><tr><th>Prestation</th><th>Quantité</th><th>Prix unitaire</th><th>Montant</th></tr></thead><tbody><%if(f.lignes()!=null)for(CaisseDao.Ligne l:f.lignes()){%><tr><td><%=Echappement.html(l.libelle())%></td><td><%=l.quantite().toPlainString()%></td><td><%=l.prix().toPlainString()%></td><td><%=l.montant().toPlainString()%></td></tr><%}%></tbody></table></div><div class="invoice-totals"><div><span>Total</span><strong><%=f.total().toPlainString()%></strong></div><div><span>Payé</span><strong><%=f.paye().toPlainString()%></strong></div><div><span>Solde restant</span><strong><%=f.restant().toPlainString()%></strong></div></div><%if(f.notes()!=null&&!f.notes().isBlank()){%><p class="access-note">Notes : <%=Echappement.html(f.notes())%></p><%}%></div>
<%if(f.restant().signum()>0&&"ANNULEE".equals(f.statut())==false){%><div class="panel"><h3>Enregistrer un paiement</h3><p>Le paiement partiel ou total est confirmé et répercuté sur la facture dans une transaction PostgreSQL.</p><form method="post" action="<%=request.getContextPath()%>/caisse/paiement" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="factureId" value="<%=f.id()%>"><label>Montant<input name="montant" type="number" min="0.01" max="<%=f.restant().toPlainString()%>" step="0.01" required value="<%=f.restant().toPlainString()%>"></label><label>Mode<select name="mode" required><option value="ESPECES">Espèces</option><option value="CARTE">Carte</option><option value="VIREMENT">Virement</option><option value="CHEQUE">Chèque</option><option value="MOBILE_MONEY">Mobile money</option></select></label><label>Référence<input name="reference" maxlength="60"></label><label>Notes<input name="notes" maxlength="1000"></label><div class="form-actions"><button class="btn btn-primary">Confirmer le paiement</button></div></form></div><%}%>
<div class="panel"><div class="panel-head"><div><h3>Historique des paiements</h3><p>Reçus téléchargeables au format PDF.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Montant</th><th>Mode</th><th>Référence</th><th>Solde après paiement</th><th>Reçu</th></tr></thead><tbody><%if(ps!=null)for(CaisseDao.Paiement pay:ps){%><tr><td><%=pay.date()%></td><td><%=pay.montant().toPlainString()%></td><td><%=Echappement.html(pay.mode())%></td><td><%=Echappement.html(pay.reference())%></td><td><%=pay.solde().toPlainString()%></td><td><a target="_blank" href="<%=request.getContextPath()%>/caisse/recu?id=<%=pay.id()%>">REC-<%=pay.id()%></a></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucun paiement enregistré pour cette facture.</p><%}%></div></div></section>
