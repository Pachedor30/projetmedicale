<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.CaisseDao,com.mycompany.projetmedical.util.Echappement" %><%List<CaisseDao.Facture> fs=(List<CaisseDao.Facture>)request.getAttribute("factures");boolean imp=(Boolean)request.getAttribute("impayees");%><section class="caisse-page"><div class="page-heading"><div><p class="eyebrow">FACTURATION</p><h2><%=imp?"Factures impayées":"Factures"%></h2><p>Soldes et paiements confirmés.</p></div><a class="btn btn-primary" href="<%=request.getContextPath()%>/caisse/nouvelle-facture" data-fragment-link>Nouvelle facture</a></div><div class="panel"><form class="toolbar" method="get" action="<%=request.getContextPath()%>/caisse/<%=imp?"impayees":"facturation"%>" data-ajax-form><input type="search" name="q" placeholder="N° facture, patient, N° dossier" value="<%=Echappement.html(request.getParameter("q"))%>"><%if(!imp){%><select name="statut"><option value="">Tous les statuts</option><%for(String st:new String[]{"EN_ATTENTE","PARTIELLEMENT_PAYEE","PAYEE","ANNULEE"}){%><option value="<%=st%>" <%=st.equals(request.getParameter("statut"))?"selected":""%>><%=st%></option><%}%></select><%}%><button class="btn btn-primary">Rechercher</button></form><div class="table-wrap"><table class="table"><thead><tr><th>Facture</th><th>Date</th><th>Patient</th><th>Total</th><th>Payé</th><th>Reste dû</th><th>Statut</th><th></th></tr></thead><tbody><%if(fs!=null)for(CaisseDao.Facture f:fs){%><tr><td><%=Echappement.html(f.numero())%></td><td><%=f.date()%></td><td><%=Echappement.html(f.numeroPatient()+" · "+f.patient())%></td><td><%=f.total().toPlainString()%></td><td><%=f.paye().toPlainString()%></td><td><strong><%=f.restant().toPlainString()%></strong></td><td><span class="chip"><%=Echappement.html(f.statut())%></span></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/caisse/facture?id=<%=f.id()%>" data-fragment-link>Ouvrir</a></td></tr><%}%></tbody></table><%if(fs==null||fs.isEmpty()){%><p class="empty-state">Aucune facture trouvée.</p><%}%></div></div></section>
