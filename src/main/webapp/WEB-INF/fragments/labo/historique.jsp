<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.LaborantinDao,com.mycompany.projetmedical.util.Echappement" %><%List<LaborantinDao.Demande> ds=(List<LaborantinDao.Demande>)request.getAttribute("demandes");%><section class="lab-page"><div class="page-heading"><div><p class="eyebrow">ARCHIVES DU LABORATOIRE</p><h2>Historique des analyses</h2><p>Demandes, résultats saisis et validations enregistrées.</p></div></div><div class="panel"><div class="table-wrap"><table class="table"><thead><tr><th>Date demande</th><th>Patient</th><th>Analyse</th><th>Valeur / unité</th><th>Résultat</th><th>Validé le</th><th></th></tr></thead><tbody><%if(ds!=null)for(LaborantinDao.Demande d:ds){%><tr><td><%=d.date()%></td><td><%=Echappement.html(d.numeroPatient()+" · "+d.patient())%></td><td><%=Echappement.html(d.type())%></td><td><%=Echappement.html(d.resultat())%> <%=Echappement.html(d.uniteResultat())%></td><td><%=Echappement.html(d.statutResultat()==null?d.statut():d.statutResultat())%></td><td><%=d.dateValidation()==null?"—":d.dateValidation()%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/labo/demande?id=<%=d.id()%>" data-fragment-link>Détail</a></td></tr><%}%></tbody></table><%if(ds==null||ds.isEmpty()){%><p class="empty-state">Aucun historique à afficher.</p><%}%></div></div></section>
