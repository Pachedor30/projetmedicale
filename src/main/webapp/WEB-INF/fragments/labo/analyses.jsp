<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.LaborantinDao,com.mycompany.projetmedical.util.Echappement" %><%List<LaborantinDao.Demande> ds=(List<LaborantinDao.Demande>)request.getAttribute("demandes");String statut=(String)request.getAttribute("statut");%><section class="lab-page"><div class="page-heading"><div><p class="eyebrow">LABORATOIRE</p><h2>Demandes d’analyses</h2><p>Consultez les demandes médicales et suivez leur traitement.</p></div></div><div class="panel"><form class="toolbar" action="<%=request.getContextPath()%>/labo/analyses" method="get" data-ajax-form><input type="search" name="q" placeholder="N° patient, nom ou analyse" value="<%=Echappement.html(request.getParameter("q"))%>"><select name="statut"><option value="">Tous les statuts</option><%for(String st:new String[]{"DEMANDEE","EN_COURS","SIS","VALIDE","ANNULEE"}){%><option value="<%=st%>" <%=st.equals(statut)?"selected":""%>><%=st%></option><%}%></select><button class="btn btn-primary">Filtrer</button></form><div class="table-wrap"><table class="table"><thead><tr><th>Priorité</th><th>Demandée le</th><th>Patient</th><th>Analyse</th><th>Prescripteur</th><th>Statut</th><th>Responsable</th><th></th></tr></thead><tbody><%if(ds!=null)for(LaborantinDao.Demande d:ds){%><tr><td><span class="chip"><%=Echappement.html(d.priorite())%></span></td><td><%=d.date()%></td><td><strong><%=Echappement.html(d.patient())%></strong><small><%=Echappement.html(d.numeroPatient())%></small></td><td><%=Echappement.html(d.type())%></td><td><%=Echappement.html(d.medecin())%></td><td><%=Echappement.html(d.statut())%><%if("SAISI".equals(d.statutResultat())){%><small>Résultat transmis</small><%}%></td><td><%=d.responsable()==null?"Non attribué":d.responsable()%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/labo/demande?id=<%=d.id()%>" data-fragment-link>Ouvrir</a></td></tr><%}%></tbody></table><%if(ds==null||ds.isEmpty()){%><p class="empty-state">Aucune demande ne correspond au filtre.</p><%}%></div></div></section>
