<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.mycompany.projetmedical.dao.LaborantinDao,com.mycompany.projetmedical.util.Echappement" %>
<% LaborantinDao.Stats s=(LaborantinDao.Stats)request.getAttribute("stats"); List<LaborantinDao.Demande> ds=(List<LaborantinDao.Demande>)request.getAttribute("demandes"); %>
<section class="lab-page">
 <div class="page-heading"><div><p class="eyebrow">ESPACE LABORATOIRE</p><h2>Tableau de bord</h2><p>Suivi des demandes et des résultats en attente de validation.</p></div></div>
 <div class="cards lab-stats" aria-label="Statistiques du laboratoire">
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-flask"/></svg></span><div><p class="card-label">Nouvelles demandes</p><p class="card-value"><%=s==null?0:s.nouvelles()%></p><p class="card-meta">À prendre en charge</p></div></article>
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-clock"/></svg></span><div><p class="card-label">Prélèvements en cours</p><p class="card-value"><%=s==null?0:s.enCours()%></p><p class="card-meta">En traitement</p></div></article>
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-clipboard"/></svg></span><div><p class="card-label">À valider indépendamment</p><p class="card-value"><%=s==null?0:s.aValider()%></p><p class="card-meta">En attente de validation</p></div></article>
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-check"/></svg></span><div><p class="card-label">Analyses validées</p><p class="card-value"><%=s==null?0:s.validees()%></p><p class="card-meta">Résultats validés</p></div></article>
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-calendar"/></svg></span><div><p class="card-label">Demandes reçues aujourd’hui</p><p class="card-value"><%=s==null?0:s.aujourdHui()%></p><p class="card-meta">Aujourd’hui</p></div></article>
 </div>
 <div class="panel"><div class="panel-head"><div><h3>Demandes récentes</h3><p>Les résultats transmis restent verrouillés pour leur auteur après validation.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Priorité</th><th>Date</th><th>Patient</th><th>Analyse</th><th>Médecin</th><th>Statut</th><th></th></tr></thead><tbody><%if(ds!=null)for(LaborantinDao.Demande d:ds){%><tr><td><span class="chip <%= "URGENTE".equals(d.priorite())?"chip-danger":""%>"><%=Echappement.html(d.priorite())%></span></td><td><%=d.date()%></td><td><%=Echappement.html(d.numeroPatient()+" · "+d.patient())%></td><td><%=Echappement.html(d.type())%></td><td><%=Echappement.html(d.medecin())%></td><td><%=Echappement.html(d.statut())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/labo/demande?id=<%=d.id()%>" data-fragment-link>Ouvrir</a></td></tr><%}%></tbody></table><%if(ds==null||ds.isEmpty()){%><p class="empty-state">Aucune demande d’analyse dans PostgreSQL.</p><%}%></div></div>
</section>
