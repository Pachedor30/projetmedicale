<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.Set,com.mycompany.projetmedical.dao.LaborantinDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes,com.mycompany.projetmedical.model.Utilisateur" %><%LaborantinDao.Demande d=(LaborantinDao.Demande)request.getAttribute("demande");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);Utilisateur u=(Utilisateur)session.getAttribute(Constantes.SESSION_UTILISATEUR);boolean possede=d.responsable()!=null&&d.responsable()==u.getId();boolean finalise="VALIDE".equals(d.statutResultat())||"VALIDE".equals(d.statut());boolean autoriseResultat=possede&&!finalise&&("EN_COURS".equals(d.statut())||"SIS".equals(d.statut()))&&(d.saisiPar()==null||d.saisiPar()==u.getId());%><section class="lab-page"><div class="page-heading"><div><p class="eyebrow">DEMANDE N° <%=d.id()%></p><h2><%=Echappement.html(d.type())%></h2><p><%=Echappement.html(d.numeroPatient()+" · "+d.patient())%> · Prescription de <%=Echappement.html(d.medecin())%></p></div><span class="chip"><%=Echappement.html(d.statut())%></span></div><%if(request.getAttribute("messageSucces")!=null){%><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><%}if(request.getAttribute("erreur")!=null){%><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><%}%>
<div class="lab-detail-grid"><div class="panel"><h3>Informations de la demande</h3><dl class="lab-facts"><dt>Patient</dt><dd><%=Echappement.html(d.patient())%></dd><dt>Numéro patient</dt><dd><%=Echappement.html(d.numeroPatient())%></dd><dt>Analyse</dt><dd><%=Echappement.html(d.type())%> <%=d.categorie()==null?"":"· "+Echappement.html(d.categorie())%></dd><dt>Prescripteur</dt><dd><%=Echappement.html(d.medecin())%></dd><dt>Priorité</dt><dd><%=Echappement.html(d.priorite())%></dd><dt>Demandée le</dt><dd><%=d.date()%></dd><dt>Notes du médecin</dt><dd><%=Echappement.html(d.observations())%></dd><dt>Responsable</dt><dd><%=possede?"Vous":d.responsable()==null?"Non attribué":"Laborantin n° "+d.responsable()%></dd></dl></div><div class="panel"><h3>Suivi du prélèvement et du résultat</h3><div class="status-track"><span class="<%=Set.of("EN_COURS","SIS","VALIDE").contains(d.statut())?"done":""%>">Demande reçue</span><span class="<%=Set.of("SIS","VALIDE").contains(d.statut())?"done":""%>">Prélèvement traité</span><span class="<%="VALIDE".equals(d.statut())?"done":""%>">Validation indépendante</span></div><%if("DEMANDEE".equals(d.statut())&&(d.responsable()==null||possede)){%><form method="post" action="<%=request.getContextPath()%>/labo/demande/prise-en-charge" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=d.id()%>"><button class="btn btn-primary">Réceptionner le prélèvement</button></form><%}else if("DEMANDEE".equals(d.statut())){%><p class="access-note">Cette demande a été attribuée à un autre laborantin.</p><%}else if("SIS".equals(d.statut())){%><p class="access-note">Résultat transmis : en attente de validation par un autre professionnel habilité.</p><%}else if("VALIDE".equals(d.statut())||"VALIDE".equals(d.statutResultat())){%><p class="alert-success">Résultat validé et verrouillé. Le laboratoire ne peut plus le modifier.</p><%}%></div></div>
<div class="panel"><div class="panel-head"><div><h3><%=d.resultatId()==null?"Saisie des résultats":"Résultat enregistré"%></h3><p>Valeur, unité, références et interprétation sont stockées dans le résultat associé à cette demande.</p></div></div><%if(autoriseResultat){%><form method="post" action="<%=request.getContextPath()%>/labo/demande/enregistrer" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="id" value="<%=d.id()%>"><label class="full">Valeur du résultat<input name="valeur" required maxlength="10000" value="<%=Echappement.html(d.resultat())%>" placeholder="Ex. 4,8 ou résultat descriptif"></label><label>Unité<input name="unite" maxlength="30" value="<%=Echappement.html(d.uniteResultat()==null?d.unite():d.uniteResultat())%>"></label><label class="full">Valeurs de référence<input name="reference" maxlength="2000" value="<%=Echappement.html(d.referenceResultat()==null?d.references():d.referenceResultat())%>"></label><label class="full">Interprétation / observations<textarea name="interpretation" rows="4" maxlength="5000"><%=Echappement.html(d.interpretation())%></textarea></label><div class="full"><button class="btn btn-primary">Transmettre pour validation indépendante</button></div></form><%}else if(d.resultatId()!=null){%><dl class="lab-facts"><dt>Valeur</dt><dd><%=Echappement.html(d.resultat())%> <%=Echappement.html(d.uniteResultat())%></dd><dt>Références</dt><dd><%=Echappement.html(d.referenceResultat())%></dd><dt>Interprétation</dt><dd><%=Echappement.html(d.interpretation())%></dd><dt>Statut du résultat</dt><dd><%=Echappement.html(d.statutResultat())%></dd><dt>Saisi le</dt><dd><%=d.dateSaisie()%></dd><dt>Validé le</dt><dd><%=d.dateValidation()==null?"En attente":d.dateValidation()%></dd></dl><%}else{%><p class="access-note">Le prélèvement doit être réceptionné par le laborantin responsable avant la saisie du résultat.</p><%}%><p class="access-note">La validation est réservée à un professionnel différent de l’auteur du résultat. Aucun bouton de validation n’est disponible dans cet espace.</p></div></section>
