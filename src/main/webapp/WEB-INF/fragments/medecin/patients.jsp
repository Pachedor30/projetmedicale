<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.MedecinDao,com.mycompany.projetmedical.util.Echappement" %><%List<MedecinDao.Patient> ps=(List<MedecinDao.Patient>)request.getAttribute("patients");%><section class="med-page"><div class="page-heading"><div><p class="eyebrow">SUIVI CLINIQUE</p><h2>Mes patients</h2><p>Patients ayant un rendez-vous avec vous ou une consultation dont vous êtes responsable.</p></div></div><div class="panel"><form class="toolbar" action="<%=request.getContextPath()%>/medecin/patients" method="get" data-ajax-form><input type="search" name="q" placeholder="N° patient, nom, téléphone" value="<%=Echappement.html(request.getParameter("q"))%>"><button class="btn btn-primary">Rechercher</button></form><div class="table-wrap"><table class="table"><thead><tr><th>N° dossier</th><th>Patient</th><th>Téléphone</th><th>Dossier médical</th><th></th></tr></thead><tbody><%if(ps!=null)for(MedecinDao.Patient p:ps){%><tr><td><%=Echappement.html(p.numero())%></td><td><strong><%=Echappement.html(p.nom())%></strong><small><%=Echappement.html(p.email())%></small></td><td><%=Echappement.html(p.telephone())%></td><td><%=p.dossierOuvert()?"Ouvert":"À ouvrir lors de la consultation"%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/medecin/patient?id=<%=p.id()%>" data-fragment-link>Fiche médicale</a></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucun patient associé à votre activité.</p><%}%></div></div></section>
