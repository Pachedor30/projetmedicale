<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.MedecinDao,com.mycompany.projetmedical.util.Echappement" %><%List<MedecinDao.Rdv> rd=(List<MedecinDao.Rdv>)request.getAttribute("rendezVous");java.time.LocalDate start=(java.time.LocalDate)request.getAttribute("dateDu");%><section class="med-page"><div class="page-heading"><div><p class="eyebrow">AGENDA PERSONNEL</p><h2>Mon calendrier</h2><p>Rendez-vous associés à votre compte médecin.</p></div></div><div class="panel"><div class="calendar-grid"><%for(int day=0;day<7;day++){java.time.LocalDate d=start.plusDays(day);%><div class="calendar-day"><h4><%=d.getDayOfWeek().getDisplayName(java.time.format.TextStyle.SHORT,java.util.Locale.FRENCH)%> <%=d.getDayOfMonth()%></h4><%if(rd!=null)for(MedecinDao.Rdv r:rd)if(r.date().equals(d)){%><article class="calendar-event"><b><%=r.debut()%>–<%=r.fin()%></b><%=Echappement.html(r.patient())%><small><%=Echappement.html(r.numero()+" · "+r.statut())%></small><a href="<%=request.getContextPath()%>/medecin/patient?id=<%=r.patientId()%>&rendezVousId=<%=r.id()%>" data-fragment-link>Ouvrir la fiche</a></article><%}%></div><%}%></div></div></section>
