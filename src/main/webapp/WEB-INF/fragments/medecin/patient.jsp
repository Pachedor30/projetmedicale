<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.MedecinDao,com.mycompany.projetmedical.util.Echappement,com.mycompany.projetmedical.util.Constantes" %>
<%MedecinDao.Patient p=(MedecinDao.Patient)request.getAttribute("patient");List<MedecinDao.Antecedent> ants=(List<MedecinDao.Antecedent>)request.getAttribute("antecedents");List<MedecinDao.Consultation> hist=(List<MedecinDao.Consultation>)request.getAttribute("historique");List<MedecinDao.Constante> vit=(List<MedecinDao.Constante>)request.getAttribute("constantes");List<MedecinDao.Prescription> prs=(List<MedecinDao.Prescription>)request.getAttribute("prescriptions");List<MedecinDao.Analyse> ans=(List<MedecinDao.Analyse>)request.getAttribute("analyses");List<MedecinDao.AnalyseType> types=(List<MedecinDao.AnalyseType>)request.getAttribute("typesAnalyse");long cid=(Long)request.getAttribute("consultationId");String csrf=(String)session.getAttribute(Constantes.SESSION_CSRF);String rdv=request.getParameter("rendezVousId");MedecinDao.Consultation active=null;if(hist!=null)for(MedecinDao.Consultation c:hist)if(c.id()==cid)active=c;%>
<section class="med-page"><div class="page-heading"><div><p class="eyebrow">FICHE MÉDICALE CONFIDENTIELLE</p><h2><%=Echappement.html(p.nom())%></h2><p><%=Echappement.html(p.numero())%> · Dossier <%=p.dossierOuvert()?"ouvert":"à créer lors de la première consultation"%></p></div><span class="chip"><%=cid>0?"Consultation en cours":"Aucune consultation active"%></span></div>
<%if(request.getAttribute("messageSucces")!=null){%><div class="alert-success"><%=Echappement.html((String)request.getAttribute("messageSucces"))%></div><%}if(request.getAttribute("erreur")!=null){%><div class="alert-error"><%=Echappement.html((String)request.getAttribute("erreur"))%></div><%}%>
<div class="med-profile-grid"><div class="panel"><h3>Informations patient</h3><dl class="patient-facts"><dt>Numéro de dossier</dt><dd><%=Echappement.html(p.numero())%></dd><dt>Email</dt><dd><%=Echappement.html(p.email())%></dd><dt>Téléphone</dt><dd><%=Echappement.html(p.telephone())%></dd><dt>Date de naissance</dt><dd><%=p.naissance()==null?"Non renseignée":p.naissance()%></dd><dt>Sexe</dt><dd><%=Echappement.html(p.sexe())%></dd></dl></div><div class="panel"><h3>Antécédents médicaux</h3><%if(ants!=null&&!ants.isEmpty())for(MedecinDao.Antecedent a:ants){%><article class="timeline-item"><b><%=Echappement.html(a.type())%> · <%=Echappement.html(a.libelle())%></b><p><%=Echappement.html(a.description())%></p><small><%=a.debut()==null?"":a.debut()%></small></article><%}else{%><p class="empty-state">Aucun antécédent enregistré.</p><%}%></div></div>
<%if(cid==0){%><div class="panel"><h3>Démarrer une consultation</h3><p>La consultation sera attribuée à votre compte et le dossier médical sera créé si nécessaire.</p><form method="post" action="<%=request.getContextPath()%>/medecin/patient/demarrer" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><%if(rdv!=null){%><input type="hidden" name="rendezVousId" value="<%=Echappement.html(rdv)%>"><%}%><label class="full">Motif de consultation<input name="motif" maxlength="500" placeholder="Motif clinique"></label><div><button class="btn btn-primary">Ouvrir la consultation</button></div></form></div><%}else{%>
<div class="panel"><div class="panel-head"><div><h3>Consultation en cours</h3><p>Compte rendu clinique et conduite à tenir.</p></div></div><form method="post" action="<%=request.getContextPath()%>/medecin/patient/enregistrer" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><input type="hidden" name="consultationId" value="<%=cid%>"><label class="full">Symptômes / motif<textarea name="motif" rows="3" maxlength="2000"><%=active==null?"":Echappement.html(active.motif())%></textarea></label><label class="full">Observations cliniques<textarea name="observations" rows="4" maxlength="10000"><%=active==null?"":Echappement.html(active.observations())%></textarea></label><label class="full">Diagnostic<textarea name="diagnostic" rows="3" maxlength="5000"><%=active==null?"":Echappement.html(active.diagnostic())%></textarea></label><label class="full">Conduite à tenir<textarea name="conduite" rows="3" maxlength="5000"><%=active==null?"":Echappement.html(active.conduite())%></textarea></label><div><button class="btn btn-primary">Enregistrer le compte rendu</button></div></form></div>
<div class="med-two-col"><div class="panel"><h3>Constantes vitales</h3><form method="post" action="<%=request.getContextPath()%>/medecin/patient/constantes" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><input type="hidden" name="consultationId" value="<%=cid%>"><label>Tension (ex. 12/8)<input name="tension" maxlength="12"></label><label>Pouls / min<input name="pouls" type="number" min="1" max="299"></label><label>Température °C<input name="temperature" type="number" min="20.1" max="44.9" step="0.1"></label><label>Poids kg<input name="poids" type="number" min="0.1" step="0.01"></label><label>Taille cm<input name="taille" type="number" min="1" step="0.1"></label><label>SpO₂ %<input name="spo2" type="number" min="1" max="100"></label><label>Glycémie<input name="glycemie" type="number" min="0" step="0.01"></label><div><button class="btn btn-primary">Enregistrer les constantes</button></div></form></div>
<div class="panel"><h3>Demander une analyse</h3><form method="post" action="<%=request.getContextPath()%>/medecin/patient/analyse" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><input type="hidden" name="consultationId" value="<%=cid%>"><label class="full">Type d’analyse<select name="typeAnalyseId" required><option value="">Choisir</option><%if(types!=null)for(MedecinDao.AnalyseType t:types){%><option value="<%=t.id()%>"><%=Echappement.html(t.libelle())%></option><%}%></select></label><label>Priorité<select name="priorite"><option>NORMALE</option><option>URGENTE</option><option>BASSE</option></select></label><label class="full">Informations au laboratoire<textarea name="observations" rows="2" maxlength="2000"></textarea></label><div><button class="btn btn-primary">Transmettre au laboratoire</button></div></form></div></div>
<div class="panel"><h3>Créer une prescription</h3><p>Une ligne de médicament par enregistrement.</p><form method="post" action="<%=request.getContextPath()%>/medecin/patient/prescription" data-ajax-form class="form-grid"><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><input type="hidden" name="consultationId" value="<%=cid%>"><label>Médicament<input name="medicament" required maxlength="160"></label><label>Dosage<input name="dosage" maxlength="60"></label><label>Posologie<input name="posologie" required maxlength="160"></label><label>Durée<input name="duree" maxlength="60"></label><label>Quantité<input name="quantite" maxlength="60"></label><label>Instructions<input name="instructions" maxlength="4000"></label><label class="full">Notes de prescription<textarea name="notes" rows="2" maxlength="2000"></textarea></label><div><button class="btn btn-primary">Créer la prescription</button></div></form></div>
<div class="panel danger-zone"><h3>Finaliser la consultation</h3><p>La finalisation verrouille les modifications de cette consultation.</p><form method="post" action="<%=request.getContextPath()%>/medecin/patient/finaliser" data-ajax-form><input type="hidden" name="csrf" value="<%=Echappement.html(csrf)%>"><input type="hidden" name="patientId" value="<%=p.id()%>"><input type="hidden" name="consultationId" value="<%=cid%>"><button class="btn btn-primary" data-confirm-submit="Finaliser et verrouiller cette consultation ?">Finaliser la consultation</button></form></div><%}%>
<div class="panel"><h3>Constantes enregistrées</h3><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Tension</th><th>Pouls</th><th>Temp.</th><th>Poids</th><th>Taille</th><th>SpO₂</th><th>Glycémie</th></tr></thead><tbody><%if(vit!=null)for(MedecinDao.Constante v:vit){%><tr><td><%=v.date()%></td><td><%=Echappement.html(v.tension())%></td><td><%=v.pouls()==null?"":v.pouls()%></td><td><%=v.temperature()==null?"":v.temperature()%></td><td><%=v.poids()==null?"":v.poids()%></td><td><%=v.taille()==null?"":v.taille()%></td><td><%=v.spo2()==null?"":v.spo2()%></td><td><%=v.glycemie()==null?"":v.glycemie()%></td></tr><%}%></tbody></table><%if(vit==null||vit.isEmpty()){%><p class="empty-state">Pas de constante enregistrée.</p><%}%></div></div>
<div class="panel"><h3>Prescriptions</h3><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Médicament</th><th>Dosage / posologie</th><th>Durée</th><th>Statut</th></tr></thead><tbody><%if(prs!=null)for(MedecinDao.Prescription x:prs){%><tr><td><%=x.date()%></td><td><%=Echappement.html(x.medicament())%></td><td><%=Echappement.html(x.dosage()+" · "+x.posologie())%></td><td><%=Echappement.html(x.duree())%></td><td><%=Echappement.html(x.statut())%></td></tr><%}%></tbody></table><%if(prs==null||prs.isEmpty()){%><p class="empty-state">Aucune prescription.</p><%}%></div></div>
<div class="panel"><h3>Analyses et résultats validés</h3><div class="table-wrap"><table class="table"><thead><tr><th>Analyse</th><th>Demandée le</th><th>Statut</th><th>Résultat validé</th><th>Unité</th></tr></thead><tbody><%if(ans!=null)for(MedecinDao.Analyse a:ans){%><tr><td><%=Echappement.html(a.type())%></td><td><%=a.date()%></td><td><%=Echappement.html(a.statut())%></td><td><%=Echappement.html(a.resultat()==null?"En attente de validation":a.resultat())%></td><td><%=Echappement.html(a.unite())%></td></tr><%}%></tbody></table><%if(ans==null||ans.isEmpty()){%><p class="empty-state">Aucune analyse demandée par vous pour ce patient.</p><%}%></div></div>
<div class="panel"><h3>Historique médical chronologique</h3><div class="timeline"><%if(hist!=null)for(MedecinDao.Consultation c:hist){%><article class="timeline-item"><div class="timeline-date"><%=c.date()%> · <%=Echappement.html(c.statut())%></div><h4><%=Echappement.html(c.motif())%></h4><p><b>Observations :</b> <%=Echappement.html(c.observations())%></p><p><b>Diagnostic :</b> <%=Echappement.html(c.diagnostic())%></p><p><b>Conduite :</b> <%=Echappement.html(c.conduite())%></p></article><%}%><%if(hist==null||hist.isEmpty()){%><p class="empty-state">Aucun antécédent de consultation.</p><%}%></div></div></section>
