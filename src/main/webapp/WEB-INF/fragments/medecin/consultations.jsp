<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.MedecinDao,com.mycompany.projetmedical.util.Echappement" %><%List<MedecinDao.Consultation> cs=(List<MedecinDao.Consultation>)request.getAttribute("consultationsEnCours");%><section class="med-page"><div class="page-heading"><div><p class="eyebrow">ACTIVITÉ CLINIQUE</p><h2>Consultations en cours</h2><p>Comptes rendus dont vous êtes le médecin responsable.</p></div></div><div class="panel"><div class="table-wrap"><table class="table"><thead><tr><th>Patient</th><th>Ouverte le</th><th>Motif</th><th></th></tr></thead><tbody><%if(cs!=null)for(MedecinDao.Consultation c:cs){%><tr><td><%=Echappement.html(c.numero()+" · "+c.patient())%></td><td><%=c.date()%></td><td><%=Echappement.html(c.motif())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/medecin/patient?id=<%=c.patientId()%>" data-fragment-link>Continuer</a></td></tr><%}%></tbody></table><%if(cs==null||cs.isEmpty()){%><p class="empty-state">Aucune consultation en cours.</p><%}%></div></div></section>
