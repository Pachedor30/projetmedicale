<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.mycompany.projetmedical.dao.MedecinDao,com.mycompany.projetmedical.util.Echappement" %><%List<MedecinDao.Patient> ps=(List<MedecinDao.Patient>)request.getAttribute("patients");%><section class="med-page"><div class="page-heading"><div><p class="eyebrow">BIOLOGIE MÉDICALE</p><h2>Analyses et résultats validés</h2><p>Choisissez un patient suivi pour consulter ses demandes et les résultats validés par le laboratoire.</p></div></div><div class="panel"><table class="table"><thead><tr><th>Patient</th><th>N° dossier</th><th></th></tr></thead><tbody><%if(ps!=null)for(MedecinDao.Patient p:ps){%><tr><td><%=Echappement.html(p.nom())%></td><td><%=Echappement.html(p.numero())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/medecin/patient?id=<%=p.id()%>" data-fragment-link>Voir analyses validées</a></td></tr><%}%></tbody></table><%if(ps==null||ps.isEmpty()){%><p class="empty-state">Aucun patient lié à votre compte.</p><%}%></div></section>
