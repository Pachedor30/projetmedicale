<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.mycompany.projetmedical.dao.MedecinDao,com.mycompany.projetmedical.util.Echappement" %>
<% MedecinDao.Stats s=(MedecinDao.Stats)request.getAttribute("stats"); List<MedecinDao.Rdv> rd=(List<MedecinDao.Rdv>)request.getAttribute("rendezVous"); List<MedecinDao.Consultation> ce=(List<MedecinDao.Consultation>)request.getAttribute("consultationsEnCours"); %>
<section class="med-page">
 <div class="page-heading"><div><p class="eyebrow">ESPACE MÉDICAL</p><h2>Tableau de bord</h2><p>Votre activité clinique et les patients suivis.</p></div></div>
 <div class="cards med-stats" aria-label="Statistiques médicales">
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-calendar"/></svg></span><div><p class="card-label">Rendez-vous du jour</p><p class="card-value"><%=s==null?0:s.rdvJour()%></p><p class="card-meta">Patients attendus aujourd’hui</p></div></article>
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-clipboard"/></svg></span><div><p class="card-label">Consultations en cours</p><p class="card-value"><%=s==null?0:s.consultationsEnCours()%></p><p class="card-meta">À finaliser</p></div></article>
  <article class="card"><span class="card-ic"><svg class="ic"><use href="#i-users"/></svg></span><div><p class="card-label">Patients suivis</p><p class="card-value"><%=s==null?0:s.patientsSuivis()%></p><p class="card-meta">Dans vos consultations</p></div></article>
 </div>
 <div class="panel"><div class="panel-head"><div><h3>Consultations en cours</h3><p>Vos consultations non finalisées.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Patient</th><th>Début</th><th>Motif</th><th></th></tr></thead><tbody><%if(ce!=null)for(MedecinDao.Consultation c:ce){%><tr><td><%=Echappement.html(c.numero()+" · "+c.patient())%></td><td><%=c.date()%></td><td><%=Echappement.html(c.motif())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/medecin/patient?id=<%=c.patientId()%>" data-fragment-link>Reprendre</a></td></tr><%}%></tbody></table><%if(ce==null||ce.isEmpty()){%><p class="empty-state">Aucune consultation en cours.</p><%}%></div></div>
 <div class="panel"><div class="panel-head"><div><h3>Rendez-vous à venir</h3><p>Vos rendez-vous aujourd’hui et dans les six prochains jours.</p></div></div><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Patient</th><th>Heure</th><th>Statut</th><th></th></tr></thead><tbody><%if(rd!=null)for(MedecinDao.Rdv r:rd){%><tr><td><%=r.date()%></td><td><%=Echappement.html(r.numero()+" · "+r.patient())%></td><td><%=r.debut()%>–<%=r.fin()%></td><td><%=Echappement.html(r.statut())%></td><td><a class="btn btn-small" href="<%=request.getContextPath()%>/medecin/patient?id=<%=r.patientId()%>&rendezVousId=<%=r.id()%>" data-fragment-link>Fiche patient</a></td></tr><%}%></tbody></table><%if(rd==null||rd.isEmpty()){%><p class="empty-state">Aucun rendez-vous sur cette période.</p><%}%></div></div>
</section>
