<div class="page-head">
    <div>
        <h2>Mes consultations</h2>
        <p class="muted">L'historique de vos consultations et leurs observations</p>
    </div>
</div>

<div class="panel">
    <div class="toolbar">
        <div class="search-wrap">
            <svg class="ic"><use href="#i-search"/></svg>
            <input type="text" class="input" data-search placeholder="Rechercher par date, médecin ou motif…">
        </div>
        <select class="input" data-filter>
            <option value="">Toutes les périodes</option>
            <option value="recente">Récentes</option>
            <option value="ancienne">Anciennes</option>
        </select>
    </div>

    <div class="empty-state">
        <svg class="ic"><use href="#i-clipboard"/></svg>
        <p>Aucune consultation enregistrée à votre nom.<br>La base de données n'est pas encore connectée.</p>
    </div>
</div>
